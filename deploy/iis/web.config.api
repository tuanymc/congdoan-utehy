<?xml version="1.0" encoding="utf-8"?>
<!--
  Mẫu web.config cho apps/api (reverse proxy sang tiến trình Node.js do PM2 quản lý, mặc định lắng
  nghe cổng nội bộ 3000 — khớp API_PORT trong .env). Đặt vào physical path của IIS Application mount
  ở "/api", nested dưới site chính (congdoan.utehy.edu.vn/api) — xem Bước 5 trong
  deploy/HUONG_DAN_CHAY_THU_SQLSERVER_IIS_PM2.md. Thư mục physical path này rỗng, KHÔNG chứa
  apps/api/dist — chỉ cần đúng 1 file web.config này để làm proxy.

  Vì Application mount ở "/api" nên IIS đã tự bóc tiền tố "/api" khỏi URL trước khi rule bên dưới
  chạy — {R:1} nhận được là phần URL SAU "/api" (vd request "/api/auth/login" → {R:1}="auth/login"),
  khớp đúng với route thật của Nest (main.ts KHÔNG có global prefix "api/", xem ghi chú trong đó).

  YÊU CẦU CÀI ĐẶT TRƯỚC trên Windows Server (một lần, không phải mỗi lần deploy):
    1. Cài "Application Request Routing" (ARR) và "URL Rewrite" module cho IIS.
    2. Trong IIS Manager -> chọn Server (cấp cao nhất) -> Application Request Routing Cache ->
       Server Proxy Settings... -> tick "Enable proxy" -> Apply.
       (Nếu không bật bước này, mọi rule reverse proxy bên dưới sẽ báo lỗi 502.)

  Đổi PORT bên dưới nếu bạn đổi API_PORT trong .env khác 3000.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- <clear /> bắt buộc: Application nested mặc định KẾ THỪA <rules> của web.config site cha
             (rule "ReactRouterSpaFallback" trong web.config.web) — không <clear /> trước, request
             tới /api/* có thể bị rule kế thừa đó xử lý (rewrite về "index.html", không tồn tại
             trong thư mục proxy rỗng này) TRƯỚC KHI tới được rule proxy thật bên dưới, làm vỡ toàn
             bộ API. -->
        <clear />
        <rule name="ReverseProxyToNodeApi" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Giới hạn kích thước request body cho upload file (điều chỉnh theo nhu cầu, đơn vị byte). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
