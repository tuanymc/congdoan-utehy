# Vite tự nạp file này khi chạy "vite build" (mode=production) — không cần đặt tay trên server.
# Cùng domain với API (site chính "/" + API mount ở "/api", xem
# deploy/HUONG_DAN_CHAY_THU_SQLSERVER_IIS_PM2.md) nên dùng path tương đối, tự động khớp domain thật
# dù là staging hay production, và tránh CORS hoàn toàn vì luôn same-origin.
VITE_API_BASE_URL="/api"
