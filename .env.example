# Sao chép file này thành .env (dev) hoặc cấu hình biến môi trường tương ứng trên server (không commit .env thật).

# --- Database (SQL Server) ---
# Dev/staging cài native (SQL Server Express), KHÔNG dùng Docker — xem docs/CURSOR_PROMPT_Website_CongDoan_UTEHY.md
DATABASE_URL="sqlserver://localhost:1433;database=CongDoanUtehy;user=sa;password=YourStrong@Passw0rd;trustServerCertificate=true"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Memurai (Redis-compatible, cài native trên Windows) ---
REDIS_URL="redis://localhost:6379"

# --- Seed ---
SEED_ADMIN_EMAIL="admin@congdoan.utehy.edu.vn"
SEED_ADMIN_PASSWORD="ChangeMe@123"

# --- API ---
API_PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Frontend (apps/web, apps/admin) ---
VITE_API_BASE_URL="http://localhost:3000"

# --- CSDL web cũ (chỉ dùng cho "pnpm migrate:legacy" — ETL nhập tin tức/chuyên mục từ web cũ) ---
# Điền giá trị THẬT vào .env trên server khi chạy ETL, KHÔNG commit giá trị thật vào git.
# Xem prisma/migrate-legacy-content.ts để biết script làm gì / không làm gì.
LEGACY_DB_HOST="45.117.177.224"
LEGACY_DB_PORT=1433
LEGACY_DB_NAME="CMS_CongDoan"
LEGACY_DB_USER="cdutehy"
LEGACY_DB_PASSWORD="change-me"
# Đặt =true để chạy thử ETL không ghi gì vào CSDL mới (chỉ log ra sẽ làm gì):
LEGACY_MIGRATE_DRY_RUN=false

# --- File đính kèm công văn (chỉ dùng cho route GET /admin/official-documents/:id/attachments/:attachmentId/download) ---
# Thư mục vật lý đã gộp từ 3 bản DocumentFiles của web cũ trên server (xem deploy guide Bước 6.5 mục 3).
# Trên server production đặt đúng: C:\inetpub\congdoan2026\document-files
DOCUMENT_FILES_DIR="./document-files"
