# Sao chép file này thành .env (dev) hoặc cấu hình biến môi trường tương ứng trên server (không commit .env thật).

# --- Database (SQL Server) ---
# Dev/staging cài native (SQL Server Express), KHÔNG dùng Docker — xem docs/CURSOR_PROMPT_Website_CongDoan_UTEHY.md
DATABASE_URL="sqlserver://localhost:1433;database=CongDoanUtehy;user=sa;password=YourStrong@Passw0rd;trustServerCertificate=true"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Memurai (Redis-compatible, cài native trên Windows) ---
REDIS_URL="redis://localhost:6379"

# --- Seed ---
SEED_ADMIN_EMAIL="admin@congdoan.hyute.edu.vn"
SEED_ADMIN_PASSWORD="ChangeMe@123"

# --- API ---
API_PORT=3000
# Dev: Vite. Production: IIS cùng site cho 2 hostname (utehy + hyute), http và https.
# apps/api/src/main.ts luôn cho phép 2 domain production; dòng này chỉ cần bổ sung origin khác.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://congdoan.utehy.edu.vn,https://congdoan.utehy.edu.vn,http://congdoan.hyute.edu.vn,https://congdoan.hyute.edu.vn"

# --- Email (tạo tài khoản công đoàn viên gửi mật khẩu về mail) ---
# Cùng Gmail SMTP với web cũ (QLEmail.aspx.cs): smtp.gmail.com:587 + STARTTLS.
# Điền SMTP_USER / SMTP_PASSWORD trên server (.env production), KHÔNG commit mật khẩu.
# Thiếu mật khẩu thì hệ thống vẫn tạo tài khoản; mật khẩu ngẫu nhiên hiện trên màn quản trị.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="congdoanutehy@gmail.com"
SMTP_PASSWORD=""
SMTP_FROM="Công đoàn HYUTE <congdoanutehy@gmail.com>"
# true nếu dùng cổng 465 (SMTPS). Cổng 587 để false (STARTTLS).
SMTP_SECURE=false
PUBLIC_WEB_URL="https://congdoan.hyute.edu.vn"

# --- CSDL web cũ (chỉ dùng cho "pnpm migrate:legacy" — ETL nhập tin tức/chuyên mục từ web cũ) ---
# Điền giá trị THẬT vào .env trên server khi chạy ETL, KHÔNG commit giá trị thật vào git.
# Xem prisma/migrate-legacy-content.ts để biết script làm gì / không làm gì.
LEGACY_DB_HOST="45.117.177.224"
LEGACY_DB_PORT=1433
LEGACY_DB_NAME="CMS_CongDoan"
LEGACY_DB_USER="cdutehy"
LEGACY_DB_PASSWORD="change-me"
# Đặt =true để chạy thử ETL không ghi gì vào CSDL mới (chỉ log ra sẽ làm gì):
LEGACY_MIGRATE_DRY_RUN=false

# --- File đính kèm công văn (chỉ dùng cho route GET /admin/official-documents/:id/attachments/:attachmentId/download) ---
# Thư mục vật lý đã gộp từ 3 bản DocumentFiles của web cũ trên server (xem deploy guide Bước 6.5 mục 3).
# Dev: đường dẫn tương đối. PM2 cwd = apps/api — "./document-files" = apps/api/document-files.
DOCUMENT_FILES_DIR="./document-files"

# --- Ảnh bài viết / ảnh bìa (POST /admin/uploads/images) ---
UPLOAD_IMAGES_DIR="./upload/images"
# File PDF/Word phổ biến pháp luật (POST /admin/uploads/files).
# UPLOAD_LEGAL_FILES_DIR="./upload/legal-education"
# PUBLIC_WEB_DIR="."

# === Production VPS (C:\inetpub\congdoan2026\shared\.env) — BẮT BUỘC đường dẫn tuyệt đối ===
# Không copy nguyên khối "./..." ở trên sang server (sẽ 404 khi tải file đính kèm).
# DOCUMENT_FILES_DIR=C:\inetpub\congdoan2026\document-files
# UPLOAD_IMAGES_DIR=C:\inetpub\congdoan2026\web\upload\images
# PUBLIC_WEB_DIR=C:\inetpub\congdoan2026\web
# UPLOAD_LEGAL_FILES_DIR=C:\inetpub\congdoan2026\web\upload\legal-education
