// Prisma schema — Website Công đoàn UTEHY
// CSDL: SQL Server (giữ nguyên loại CSDL theo bản thiết kế, không đổi sang Postgres/MySQL).
//
// Triển khai theo 5 domain (xem docs/CURSOR_PROMPT_Website_CongDoan_UTEHY.md mục 4):
//   1. System      — ĐÃ triển khai đầy đủ ở đây (Phase 1: Auth & RBAC).
//   2. Content     — ĐÃ triển khai Post/Category làm module mẫu (vertical slice minh hoạ pattern).
//   3. Membership  — CHƯA triển khai, làm ở Phase 2 (Member, Leader, Position, Term, Department...).
//      Bảng tblCongDoanVien web cũ KHÔNG tồn tại trên CSDL production (đã xác nhận thực tế, không
//      còn là giả định) — không có dữ liệu cũ cần giữ chỗ cho phần này.
//   4. OfficialDocument — ĐÃ triển khai (Phase 3): DocumentType/OfficialDocument/DocumentAttachment,
//      thay 4 bảng tblLoaiCV/tblNoiDungCV/tblFileDinhKem/tblPostCongVan cũ. Xây sau khi xác nhận CSDL
//      production web cũ có dữ liệu thật (18 loại công văn / 94 công văn / 92 file đính kèm — xem
//      deploy guide Bước 6.5). tblPostCongVan (0 dòng, bảng liên kết không dùng) KHÔNG migrate.
//   5. DigitalUtility   — CHƯA triển khai, làm ở Phase 4 (Tiện ích số Công đoàn).
//
// Không xoá comment TODO bên dưới khi bổ sung domain mới — đó là điểm neo cho các phase tiếp theo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ============================================================================
// DOMAIN: SYSTEM — người dùng, vai trò, quyền, nhật ký thao tác
// ============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  authoredPosts Post[]
  /// Cán bộ được phân công xử lý yêu cầu hỗ trợ "Dịch vụ công" (Phase 4e) — xem
  /// PublicServiceSupportRequest.assignedTo. onDelete: SetNull ở phía kia (không cascade xoá yêu cầu
  /// hỗ trợ khi xoá tài khoản cán bộ).
  assignedPublicServiceSupportRequests PublicServiceSupportRequest[]

  /// Công đoàn viên liên kết với tài khoản này (nếu có) — xem UnionMember.userId. Optional 1-1: không
  /// phải User nào cũng là công đoàn viên (vd tài khoản ADMIN/UNION_CLERK thuần quản trị).
  linkedUnionMember UnionMember?

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  /// Mã vai trò cố định dùng trong code (ADMIN | UNION_CLERK | DEPARTMENT_OFFICER | MEMBER).
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  /// Định dạng "module:action", vd "post:create", "member:approve" — xem packages/types/src/system.ts
  key         String   @unique
  module      String
  action      String
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  /// Lưu SHA-256 hash của refresh token, không lưu token gốc.
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  entityType   String
  entityId     String
  /// JSON dạng { field: { before, after } } — xem packages/types/src/system.ts AuditLogDto.
  changesJson  String?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// DOMAIN: CONTENT — bài viết + chuyên mục (module mẫu, thay 12 bảng NewsXxx cũ)
// ============================================================================

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // legacyCode = tblCategory.Id (web cũ), dùng để ETL nhận diện đúng bản ghi đã nhập ở lần chạy
  // trước — KHÔNG @unique (SQL Server chỉ cho 1 NULL/UNIQUE thường, mà bản ghi tạo tay trên admin
  // luôn có legacyCode=NULL, xem prisma/migrate-legacy-content.ts hàm upsertByLegacyCode()). Thêm
  // sau khi phát hiện thật trên production: ETL trước đây chỉ khớp theo "slug", chạy ETL lần 2 (vá
  // lỗi coverImageUrl) đã hiểu nhầm slug đã tồn tại (của chính bản ghi đó) là bị "chiếm" bởi bản ghi
  // khác, tự thêm hậu tố "-2" và TẠO MỚI thay vì cập nhật — gây trùng dữ liệu.
  legacyCode String?

  /// true nếu đây là 1 trong các chuyên mục thuộc nhóm "Giới thiệu" ở web cũ (Giới thiệu chung, Chức
  /// năng nhiệm vụ, Ban chấp hành, Cơ cấu tổ chức, BCH Công đoàn qua các thời kỳ, Ủy ban kiểm tra, Ban
  /// Tuyên giáo nữ công, Ban Văn thể, Ban Tài chính, Ban Thanh tra nhân dân, Ban Chính sách pháp luật,
  /// Văn phòng, Ban chuyên môn — đối chiếu trực tiếp từ menu footer web cũ, KHÔNG đoán) — ETL tự nhận
  /// diện bằng cách so khớp tên (xem hàm isAboutCategoryName() trong migrate-legacy-content.ts), admin
  /// có thể bật/tắt tay qua trang Chuyên mục sau này. apps/web dùng cờ này để gom bài viết các chuyên
  /// mục này vào trang "Giới thiệu" thay vì phải hard-code nội dung tĩnh như trước.
  isAboutSection Boolean @default(false)

  /// false = KHÔNG hiện chuyên mục này trong dropdown "Tin hoạt động" tự động ở menu chính (xem
  /// MenuItemsService.buildAutoCategoryEntries() — trước đây MỌI category isAboutSection=false đều
  /// tự hiện trong menu, không có cách nào ẩn bớt trừ khi hard-code danh sách loại trừ trong code).
  /// KHÔNG ảnh hưởng gì tới việc bài viết chuyên mục này có hiển thị ở trang /tin-tuc hay không — chỉ
  /// ẩn/hiện MỤC MENU trỏ tới chuyên mục, bài viết vẫn xem được bình thường nếu biết đường dẫn/slug.
  showInMenu Boolean @default(true)

  posts Post[]

  @@index([legacyCode])
  @@map("categories")
}

// SQL Server connector của Prisma KHÔNG hỗ trợ enum gốc của CSDL (native enum) — xem
// https://www.prisma.io/docs/orm/reference/database-features#misc — nên `status` dùng String,
// validate giá trị hợp lệ ở tầng ứng dụng (xem PostStatus trong packages/types/src/content.ts và
// @IsEnum ở create-post.dto.ts/update-post.dto.ts). KHÔNG đổi lại thành `enum` khi sửa domain này.
model Post {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  excerpt       String?
  content       String    @db.NVarChar(Max)
  coverImageUrl String?
  status        String    @default("DRAFT") @db.VarChar(20)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // legacyCode = tblPost.Id (web cũ) — cùng lý do/cách dùng như Category.legacyCode ở trên.
  legacyCode String?

  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([legacyCode])
  @@map("posts")
}

// ============================================================================
// DOMAIN: OFFICIALDOCUMENT — công văn đi/đến + file đính kèm (Phase 3)
//
// Nguồn dữ liệu thật đã xác nhận là [tblDocument] (2.494 dòng, hệ "quản lý công văn" riêng trong
// web_cu/MyWeb/CV2/, KHÔNG phải tblNoiDungCV — bảng đó chỉ có 94 dòng, có thể là bản thử nghiệm bỏ
// dở). Ý nghĩa từng cột được xác nhận bằng cách đọc trực tiếp code-behind (CV2/Document/*.aspx.cs)
// và enum trong CV2/Common/ECommon.cs, không suy đoán từ tên cột:
//   - cột [DocumentType] (int) = HƯỚNG văn bản (enum EOFFICE.Common.DocumentType): 1=dự thảo,
//     2=công văn đi, 3=công văn đến. Map vào field `direction` bên dưới.
//   - cột [Status] (int, lưu dạng string) = enum EOFFICE.Common.DocumentStatus (1..7: lưu bản thảo/
//     gửi bản thảo/chờ xuất bản/đã xuất bản/đã xử lý/đang xử lý/bị trả lại). Map vào field `status`.
//   - cột [IDDocumentKind] = FK thật tới tblDocumentKind (loại công văn, có phân cấp cha/con qua
//     DocumentKindParent) — model DocumentType bên dưới, KHÔNG liên quan tới tblLoaiCV.
//   - cột [Attachs] = danh sách AttachID cách nhau bởi dấu phẩy, trỏ tới tblAttach (Name/Description/
//     Path) — KHÔNG phải tblFileDinhKem (bảng đó chỉ liên kết với tblNoiDungCV). File vật lý nằm ở
//     web_cu/MyWeb/CV2/Document/DocumentFiles/{username}/... và THẬT SỰ tồn tại trong bản upload —
//     xem hướng dẫn deploy Bước 6.5 để copy sang server mới.
//   - cột [PublishOffical] = FK tới tblOffical (đơn vị phát hành) — lưu tên đơn vị (resolve lúc ETL)
//     vào field `issuingOfficeName`, không xây thêm domain "đơn vị" riêng cho một field duy nhất.
//   - cột [IDUserCreate]/[UserProcess] = FK tới tblUser (người tạo/danh sách người xử lý) — lưu tên
//     hiển thị (resolve lúc ETL) vào field text, không xây lại luồng duyệt/xử lý (xem ghi chú dưới).
//   - cột [ShowWeb]: 1 = công khai, 2 = nội bộ — map vào field `isPublic`.
// CHỦ ĐỘNG KHÔNG xây lại đầy đủ luồng duyệt/xử lý (workflow StartProcess/EndProcess/UserComments) —
// bản này là lưu trữ + tra cứu công văn, không phải hệ thống quản lý công văn có luồng duyệt. Các
// mốc thời gian StartProcess/EndProcess vẫn giữ lại (processStartAt/processEndAt) để tham khảo.
// ============================================================================

/// "Loại công văn" — nguồn: tblDocumentKind (18+ loại thật, có thể phân cấp cha/con).
model DocumentType {
  id        String   @id @default(uuid())
  name      String
  description String?
  /// Tự tham chiếu — khớp cột DocumentKindParent ở tblDocumentKind (loại công văn có thể có loại cha).
  parentId  String?
  /// SQL Server không cho phép cascade tự động qua self-relation (nguy cơ multiple cascade paths) —
  /// Prisma bắt buộc khai rõ onDelete/onUpdate = NoAction ở đây, KHÔNG được để mặc định. Nếu xoá 1
  /// "loại cha", các "loại con" chỉ mất liên kết cha (parentId phải tự set null qua code nếu cần) —
  /// nhưng thực tế service.remove() đã chặn xoá khi còn loại con (xem document-types.service.ts).
  parent    DocumentType?  @relation("DocumentTypeParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  DocumentType[] @relation("DocumentTypeParent")
  /// Mã gốc (DocumentKindID) từ web cũ — dùng để script ETL tra cứu bản ghi đã nhập trước đó và
  /// upsert an toàn khi chạy lại nhiều lần. KHÔNG đặt @unique: SQL Server chỉ cho phép 1 NULL trong
  /// 1 UNIQUE constraint thường, mà bản ghi tạo tay trên admin sau này sẽ luôn có legacyCode = NULL.
  /// ETL tự đảm bảo không trùng lặp bằng findFirst trước khi create, không dựa vào ràng buộc CSDL.
  legacyCode String?
  createdAt DateTime @default(now())

  documents OfficialDocument[]

  @@index([legacyCode])
  @@map("document_types")
}

/// "Công văn" — nguồn: tblDocument (2.494 dòng thật).
model OfficialDocument {
  id             String   @id @default(uuid())
  title          String
  documentNumber String?
  content        String?  @db.NVarChar(Max)
  summary        String?  @db.NVarChar(Max)
  /// "DRAFT" (dự thảo) | "OUTGOING" (công văn đi) | "INCOMING" (công văn đến) — map từ cột
  /// [DocumentType] (int) web cũ theo đúng enum EOFFICE.Common.DocumentType (1/2/3), xem giải thích
  /// ở đầu domain block.
  direction      String   @default("DRAFT") @db.VarChar(20)
  /// Map từ cột [Status] (int 1..7) web cũ theo đúng enum EOFFICE.Common.DocumentStatus — giữ
  /// nguyên tên hằng số gốc (SAVE_DRAFT/SEND_DRAFT/WAIT_PUBLISH/PUBLISHED/PROCESSED/PROCESSING/
  /// SEND_AGAIN) để không mất thông tin, dù bản này chưa có UI thao tác đổi trạng thái theo luồng.
  status         String   @default("SAVE_DRAFT") @db.VarChar(20)
  priority       String?
  /// true nếu web cũ có ShowWeb=1 (hiển thị công khai), false nếu ShowWeb=2 (nội bộ). Dùng làm bộ lọc
  /// cho endpoint công khai GET /public/official-documents (chỉ trả về công văn isPublic=true, không
  /// JWT) — xem public-official-documents.controller.ts; endpoint /admin/official-documents (yêu cầu
  /// permission document:*) vẫn trả về toàn bộ không phân biệt cờ này.
  isPublic       Boolean  @default(false)

  issuedAt         DateTime?
  sentAt           DateTime?
  receivedAt       DateTime?
  /// Mốc bắt đầu/kết thúc xử lý ở web cũ — giữ lại để tham khảo, KHÔNG có UI thao tác theo các mốc
  /// này (xem ghi chú "chủ động không xây lại workflow" ở đầu domain block).
  processStartAt   DateTime?
  processEndAt     DateTime?

  /// Tên đơn vị phát hành, resolve từ tblOffical lúc ETL (xem giải thích ở đầu domain block).
  issuingOfficeName String?
  /// Tên người tạo, resolve từ tblUser.IDUserCreate lúc ETL.
  createdByName     String?
  /// Danh sách tên người được giao xử lý (nối bằng ", "), resolve từ tblUser.UserProcess lúc ETL —
  /// thông tin tham khảo, không phải danh sách assignee có thể thao tác trong hệ thống mới.
  processedByNames  String?  @db.NVarChar(Max)
  /// Nội dung SendOfficals gốc (đơn vị nhận) — giữ nguyên dạng text, chưa chuẩn hoá thành quan hệ.
  sentToRaw         String?  @db.NVarChar(Max)

  /// Mã gốc (DocumentID) từ web cũ — xem giải thích ở DocumentType.legacyCode.
  legacyCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  documentTypeId String
  /// onUpdate: NoAction bắt buộc — cùng lý do như DocumentType.parent ở trên (SQL Server chặn cascade
  /// path đi qua bảng có self-relation). onDelete: NoAction (connector SQL Server của Prisma KHÔNG hỗ
  /// trợ `Restrict` — chỉ Cascade/NoAction/SetNull/SetDefault; NoAction có hành vi tương đương Restrict
  /// trên SQL Server, tức là chặn xoá nếu còn công văn tham chiếu). service.remove() đã tự chặn xoá
  /// DocumentType còn công văn thuộc loại đó ở tầng ứng dụng — FK NoAction chỉ là lớp bảo vệ thứ 2.
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  attachments DocumentAttachment[]

  @@index([documentTypeId])
  @@index([direction, status])
  @@index([legacyCode])
  @@map("official_documents")
}

/// File đính kèm công văn — nguồn: tblAttach (KHÔNG phải tblFileDinhKem, xem giải thích ở đầu domain
/// block), tra theo danh sách AttachID trong cột [Attachs] của tblDocument.
model DocumentAttachment {
  id          String    @id @default(uuid())
  fileName    String
  description String?
  /// Đường dẫn tương đối giữ nguyên từ web cũ (cột Path, vd "DocumentFiles/admin/xxx.pdf") — copy
  /// nguyên thư mục DocumentFiles từ web_cu sang server mới thì link vẫn đúng cấu trúc thư mục con
  /// theo username (xem hướng dẫn deploy Bước 6.5); KHÔNG tự suy ra URL công khai, chỉ lưu path gốc.
  path        String
  uploadedAt  DateTime?
  /// Mã gốc (AttachID) từ web cũ — xem giải thích ở DocumentType.legacyCode.
  legacyCode  String?

  documentId String
  /// onUpdate: NoAction bắt buộc (cùng lý do các relation khác trong domain này) — onDelete: Cascade
  /// giữ nguyên có chủ đích: xoá 1 công văn thì xoá luôn file đính kèm của nó.
  document   OfficialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([documentId])
  @@index([legacyCode])
  @@map("document_attachments")
}

// ============================================================================
// DOMAIN: HOMESLIDE — banner/slide ảnh trang chủ (thay tblSlide web cũ)
// ============================================================================

/// Banner trượt ở đầu trang chủ — nguồn: tblSlide (Name, Image, Active); web cũ lọc "Active=1" khi
/// hiển thị (xem modules/uc_Slide.ascx.cs) — giữ đúng field tương ứng, thêm sortOrder vì tblSlide
/// không có cột thứ tự riêng (web cũ hiển thị theo thứ tự Id mặc định).
model HomeSlide {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  /// Bấm vào ảnh chuyển tới đâu — web cũ KHÔNG có cột này ở tblSlide (chỉ tblSlideLink mới có Link,
  /// nhưng đó là banner khác, không migrate) — field mới hoàn toàn cho web mới, mặc định null (ảnh
  /// không click được, giống hệt hành vi gốc của tblSlide).
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mã gốc (tblSlide.Id) từ web cũ — xem giải thích ở DocumentType.legacyCode.
  legacyCode String?

  @@index([legacyCode])
  @@map("home_slides")
}

// ============================================================================
// DOMAIN: UNIONDIRECTORY — danh bạ công đoàn viên công khai (thay 1 phần Membership Phase 2)
//
// Web cũ có bảng NHANVIEN (~90 cột, hồ sơ nhân sự ĐẦY ĐỦ: CMND, ngày sinh, tình trạng hôn nhân,
// thành phần xuất thân, sổ BHXH, đảng tịch...) dùng cho quản lý nhân sự nội bộ, nhưng trang công khai
// modules/GioiThieuCongDoanVien.aspx CHỈ hiển thị 4 trường: Họ tên, Trình độ (chuyên môn cao nhất),
// Chức vụ, Điện thoại di động, Email — lọc NHANVIEN.STATUS=1, lọc/nhóm theo CongDoanBoPhan (đối
// chiếu trực tiếp từ code-behind GioiThieuCongDoanVien.aspx.cs, KHÔNG đoán). 2 model bên dưới CHỈ giữ
// đúng các trường công khai này — CHỦ ĐỘNG không nhập các trường nhạy cảm còn lại (CMND, ngày sinh,
// sức khoẻ, lương, đảng tịch...) vì không phục vụ mục đích hiển thị công khai và tránh rủi ro lộ dữ
// liệu cá nhân không cần thiết.
// ============================================================================

/// "Công đoàn bộ phận" — nguồn: CONGDOANBOPHAN, dùng để lọc/nhóm danh bạ (KHÔNG phải NHANVIEN.PHONGBAN
/// — 1 field khác trên web cũ, không dùng để lọc danh bạ công khai, xem code-behind).
model UnionDepartment {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// Mã gốc (CONGDOANBOPHAN.MACDBP) từ web cũ — xem giải thích ở DocumentType.legacyCode.
  legacyCode String?

  members UnionMember[]

  /// Ban chấp hành công đoàn bộ phận theo từng nhiệm kỳ (chỉ có ở những bộ phận có tổ chức công đoàn
  /// riêng) — xem UnionCommitteeMember.departmentId. Null ở đó = Ban chấp hành công đoàn TRƯỜNG (cấp
  /// cao nhất), không thuộc bộ phận nào.
  committeeMembers UnionCommitteeMember[]

  @@index([legacyCode])
  @@map("union_departments")
}

/// Công đoàn viên hiển thị công khai — nguồn: NHANVIEN (chỉ lấy field công khai, xem giải thích đầu
/// domain block).
model UnionMember {
  id       String @id @default(uuid())
  fullName String
  /// Ảnh đại diện — nguồn NHANVIEN.HINHANH, cùng cơ chế chuẩn hoá path như Post.coverImageUrl (xem
  /// normalizeAssetPath trong migrate-legacy-content.ts). Null = dùng ảnh mặc định phía FE (web cũ
  /// dùng "upload/images/AnhCDV/avatar.jpg" làm ảnh mặc định).
  photoUrl String?
  /// Trình độ chuyên môn cao nhất, đã resolve tên hiển thị sẵn lúc ETL (nguồn
  /// NHANVIEN.TD_CHUYENMONCAONHAT tra qua bảng TRINHDOHOCVAN.GHICHU — xem hàm LayTrinhDo() trong
  /// GioiThieuCongDoanVien.aspx.cs) — lưu thẳng text hiển thị, không xây bảng danh mục trình độ riêng
  /// chỉ để phục vụ 1 field.
  degreeLabel String?
  /// Chức vụ (nếu có), đã resolve tên hiển thị sẵn lúc ETL (nguồn NHANVIEN.CHUCVU tra qua bảng
  /// CHUCVU.TENCV — xem hàm LayChucVu()) — cùng lý do lưu thẳng text như degreeLabel.
  positionTitle String?
  phone         String?
  email         String?
  /// true nếu NHANVIEN.STATUS=1 (web cũ chỉ hiển thị công khai đúng điều kiện này) — admin có thể tự
  /// tắt hiển thị 1 người mà không cần xoá bản ghi (vd nghỉ việc nhưng chưa muốn xoá dữ liệu).
  isPublic  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departmentId String?
  department   UnionDepartment? @relation(fields: [departmentId], references: [id])

  /// Mã gốc (NHANVIEN.MANV) từ web cũ — xem giải thích ở DocumentType.legacyCode.
  legacyCode String?

  /// Hồ sơ nội bộ đầy đủ (~90 cột gốc NHANVIEN, CHỈ dành cho màn hình quản trị — xem UnionMemberProfile).
  /// Optional 1-1: không phải công đoàn viên nào cũng có/cần nhập hồ sơ chi tiết ngay.
  profile UnionMemberProfile?

  /// Liên kết tới tài khoản đăng nhập (User) để công đoàn viên tự sửa thông tin/đổi mật khẩu ở màn hình
  /// "/cong-doan-vien" (self-service portal). Optional 1-1: không phải công đoàn viên nào cũng có tài
  /// khoản đăng nhập. Admin gán/gỡ liên kết này bằng cách nhập email tài khoản (KHÔNG dùng danh sách
  /// /users vì endpoint đó chỉ ADMIN gọi được, trong khi UNION_CLERK cũng quản lý màn hình này — xem
  /// UnionMemberForm.tsx). onDelete: SetNull — xoá tài khoản đăng nhập không xoá công đoàn viên.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Lịch sử tham gia Ban chấp hành công đoàn qua các nhiệm kỳ (xem UnionCommitteeMember) — 1 công
  /// đoàn viên có thể xuất hiện ở nhiều nhiệm kỳ/nhiều bộ phận khác nhau.
  committeeMemberships UnionCommitteeMember[]

  @@index([departmentId])
  @@index([legacyCode])
  @@map("union_members")
}

/// Hồ sơ nội bộ đầy đủ của công đoàn viên — bổ sung phần còn lại của NHANVIEN (~90 cột gốc) mà
/// UnionMember (bảng danh bạ CÔNG KHAI ở trên) CHỦ ĐỘNG không nhập, theo đúng lý do đã ghi ở đầu domain
/// block UNIONDIRECTORY. Model này CHỈ phục vụ màn hình quản trị nội bộ (apps/admin) — KHÔNG có endpoint
/// công khai nào trả về field của model này, KHÔNG được UnionMembersService.listPublic()/tương đương
/// include. Toàn bộ field optional vì dữ liệu ETL từ web cũ không đầy đủ cho mọi người.
model UnionMemberProfile {
  id String @id @default(uuid())

  memberId String      @unique
  member   UnionMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // --- Thông tin cá nhân (NHANVIEN: BIDANH, GIOITINH, NGAYSINH, NOISINH, CMND...) ---
  /// Bí danh — nguồn NHANVIEN.BIDANH.
  alias String?
  /// Giới tính — nguồn NHANVIEN.GIOITINH (lưu thẳng nhãn "Nam"/"Nữ" do dữ liệu gốc không có bảng danh
  /// mục riêng, admin nhập tay hoặc chọn từ danh sách cố định phía FE).
  gender String?
  dateOfBirth      DateTime?
  /// Nơi sinh — nguồn NHANVIEN.NOISINH.
  placeOfBirth     String?
  /// Số CMND/CCCD — nguồn NHANVIEN.CMND.
  idCardNumber     String?
  idCardIssuedDate DateTime?
  /// Nơi cấp CMND/CCCD — nguồn NHANVIEN.NOICAPCMND.
  idCardIssuedPlace String?
  ethnicity  String?
  religion   String?
  nationality String?
  /// Quê quán — nguồn NHANVIEN.QUEQUAN.
  hometown   String?
  /// Địa chỉ thường trú — nguồn NHANVIEN.DIACHITHUONGTRU.
  permanentAddress String?
  /// Nơi ở hiện nay — nguồn NHANVIEN.NOIOHIENNAY.
  currentAddress   String?
  /// Địa chỉ liên lạc (nếu khác nơi ở hiện nay) — nguồn NHANVIEN.DIACHILIENLAC.
  contactAddress   String?
  officePhone String?
  homePhone   String?
  maritalStatus     String?
  /// Thành phần xuất thân — nguồn NHANVIEN.THANHPHANXUATTHAN.
  familyBackground  String?
  /// Diện ưu tiên gia đình — nguồn NHANVIEN.DIENUUTIENGIADINH.
  familyPriorityGroup String?
  /// Diện ưu tiên bản thân — nguồn NHANVIEN.DIENUUTIENBANTHAN.
  selfPriorityGroup   String?
  talent       String?
  healthStatus String?
  bloodType    String?
  heightCm     Int?
  weightKg     Int?
  disability   String?

  // --- Công tác (NHANVIEN: PHONGBAN, BOPHAN, SOQD, các mốc ngày vào ngành/hợp đồng/tuyển dụng...) ---
  /// Phòng/Ban/Khoa công tác — nguồn NHANVIEN.PHONGBAN (khác UnionMember.department, đó là "công đoàn
  /// bộ phận" nguồn CONGDOANBOPHAN dùng để lọc danh bạ công khai — 2 hệ phân loại độc lập ở web cũ).
  facultyOrDepartmentLabel String?
  /// Bộ phận công tác cụ thể (tổ/nhóm nhỏ hơn PHONGBAN) — nguồn NHANVIEN.BOPHAN.
  workUnit                String?
  /// Số quyết định (tuyển dụng/bổ nhiệm...) — nguồn NHANVIEN.SOQD.
  decisionNumber          String?
  joinedEducationSectorDate DateTime?
  contractDate              DateTime?
  recruitmentDate            DateTime?
  joinedAgencyDate           DateTime?
  recruitmentMethod   String?
  recruitingAgency    String?
  assignedJob String?
  currentJob  String?

  // --- Đảng (NHANVIEN: NGAYVAODANG, NGAYCHINHTHUCVAODANG, CHIBO...) ---
  partyCandidateDate DateTime?
  partyOfficialDate  DateTime?
  partyJoinedPlace String?
  partyPosition    String?
  partyLeftDate      DateTime?
  partyCardNumber String?
  partyCell       String?

  // --- Đoàn Thanh niên (NHANVIEN: NGAYVAODOAN, NOIVAODOAN, CHUCVUDOAN) ---
  youthUnionJoinedDate  DateTime?
  youthUnionJoinedPlace String?
  youthUnionPosition    String?

  // --- Công đoàn (NHANVIEN: NGAYVAOCONGDOAN, NOIVAOCONGDOAN, CHUCVUCONGDOAN, CONGDOANBOPHAN) ---
  unionJoinedDate  DateTime?
  unionJoinedPlace String?
  /// Chức vụ công đoàn (khác UnionMember.positionTitle — đó là chức vụ chuyên môn NHANVIEN.CHUCVU).
  unionPosition    String?
  /// Nhãn "công đoàn bộ phận" ghi thẳng từ NHANVIEN.CONGDOANBOPHAN lúc ETL — chỉ để đối chiếu/tra cứu,
  /// việc lọc danh bạ thật sự vẫn dùng UnionMember.departmentId (quan hệ UnionDepartment).
  unionSectionLabel String?

  // --- Học vấn / Đào tạo (NHANVIEN: TD_HOCVANNV, NGANHDAOTAO, NAMTOTNGHIEP...) ---
  generalEducationLevel String?
  hasGraduated          Boolean?
  trainingField    String?
  trainingMajor    String?
  trainingPlace    String?
  trainingMethod   String?
  graduationYear         Int?
  hasPedagogyTraining    Boolean?
  politicalTheoryLevel   String?
  stateManagementLevel   String?
  educationManagementLevel String?
  mainForeignLanguage String?
  foreignLanguageLevel String?
  otherForeignLanguage String?
  itLevel              String?

  // --- Lương / BHXH / trạng thái công tác (NHANVIEN: GhiChuLuong, SOBHXH, NGAYNGHIHUU...) ---
  salaryNote    String?
  seniorityNote String?
  /// Chức danh nghề nghiệp (khác UnionMember.positionTitle) — nguồn NHANVIEN.CHUCDANHNGHENGHIEP.
  jobTitle     String?
  salaryGrade  String?
  laborType    String?
  socialInsuranceNumber    String?
  oldSocialInsuranceNumber String?
  retirementDate DateTime?
  incomingStatus String?
  incomingDate     DateTime?
  outgoingStatus String?
  outgoingDate     DateTime?

  // --- Mã tra cứu nội bộ khác (giữ lại để đối chiếu, không phục vụ nghiệp vụ hiện tại) ---
  /// Nguồn NHANVIEN.MALUONGNV.
  salaryCode String?
  /// Nguồn NHANVIEN.MAHOSONV.
  fileCode   String?
  /// Nguồn NHANVIEN.donvi — cột tên thường, ý nghĩa chính xác chưa rõ so với PHONGBAN (có thể là đơn
  /// vị cấp cao hơn, vd trường/viện trực thuộc) — giữ nguyên để tra cứu, chưa suy diễn.
  unitLabel  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("union_member_profiles")
}

// ----------------------------------------------------------------------------
// Ban chấp hành công đoàn + Nhiệm kỳ — nguồn NHIEMKY, NHANVIEN_NHIEMKY, tblPhongBan_NV_NK ở web cũ
// (đọc trực tiếp docs/script.sql). Web cũ lưu NHANVIEN_NHIEMKY như 1 bản COPY TOÀN BỘ ~90 cột
// NHANVIEN cho MỖI lần 1 người vào 1 nhiệm kỳ (antipattern — trùng lặp dữ liệu, khó đồng bộ khi sửa
// hồ sơ gốc). Bản mới KHÔNG lặp lại cách này: UnionCommitteeMember chỉ lưu (nhiệm kỳ, công đoàn viên,
// bộ phận, chức vụ) — hồ sơ chi tiết luôn tham chiếu ngược về UnionMember/UnionMemberProfile hiện tại.
//
// tblPhongBan_NV_NK xác nhận Ban chấp hành cũ có 2 CẤP: Ban chấp hành công đoàn TRƯỜNG (không thuộc bộ
// phận nào) và Ban chấp hành/tổ công đoàn BỘ PHẬN (gắn với 1 CONGDOANBOPHAN cụ thể) — UnionCommitteeMember
// mô hình hoá bằng departmentId optional (null = cấp trường).
// ----------------------------------------------------------------------------

/// 1 nhiệm kỳ Ban chấp hành công đoàn (vd "Nhiệm kỳ 2023 - 2028") — nguồn NHIEMKY.
model UnionTerm {
  id   String @id @default(uuid())
  name String

  startYear Int?
  endYear   Int?

  description String?

  /// Đánh dấu nhiệm kỳ đang đương nhiệm — trang công khai mặc định chỉ hiển thị nhiệm kỳ này, các
  /// nhiệm kỳ khác xem như lịch sử. Không ràng buộc DB chỉ-1-true, service tự đảm bảo khi set.
  isCurrent Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  committeeMembers UnionCommitteeMember[]

  @@map("union_terms")
}

/// 1 lượt 1 công đoàn viên giữ 1 chức vụ Ban chấp hành trong 1 nhiệm kỳ (có thể ở cấp trường hoặc cấp
/// bộ phận) — nguồn NHANVIEN_NHIEMKY + tblPhongBan_NV_NK, đã bỏ phần lặp lại hồ sơ (xem chú thích
/// domain block phía trên).
model UnionCommitteeMember {
  id String @id @default(uuid())

  termId String
  term   UnionTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  memberId String
  member   UnionMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Null = Ban chấp hành công đoàn TRƯỜNG (cấp cao nhất). Có giá trị = Ban chấp hành/tổ công đoàn của
  /// 1 công đoàn bộ phận cụ thể — xem tblPhongBan_NV_NK ở web cũ.
  departmentId String?
  department   UnionDepartment? @relation(fields: [departmentId], references: [id])

  /// Chức vụ trong Ban chấp hành (vd "Chủ tịch", "Phó Chủ tịch", "Uỷ viên Ban Thường vụ", "Uỷ viên
  /// Ban chấp hành") — lưu text tự do, không xây bảng danh mục riêng (cùng lý do như
  /// UnionMember.positionTitle).
  positionTitle String

  sortOrder Int     @default(0)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId])
  @@index([memberId])
  @@index([departmentId])
  @@map("union_committee_members")
}

// ============================================================================
// DOMAIN: CONTACT — form "Liên hệ" trang công khai
//
// Web cũ có bảng tblContact nhưng KHÔNG có bất kỳ trang/code-behind nào ghi vào bảng đó (đã grep toàn
// bộ web_cu/MyWeb/**/*.cs, không thấy tham chiếu) — trang /lien-he web cũ chỉ là nội dung tĩnh, KHÔNG
// có form gửi thật. Model bên dưới là tính năng MỚI hoàn toàn cho web mới, không migrate gì từ đâu cả.
// ============================================================================

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String   @db.NVarChar(Max)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

// ============================================================================
// DOMAIN: MENUITEM — menu điều hướng chính trang công khai (apps/web Header.tsx)
//
// Trước đây menu bị hard-code trong Header.tsx (Trang chủ, Giới thiệu▾, Tin hoạt động▾, Văn bản▾...),
// mỗi lần đổi cấu trúc menu đều phải sửa code + build/deploy lại. Model này đưa toàn bộ menu vào DB
// để quản trị viên tự sửa qua trang admin — không migrate gì từ web cũ, tính năng mới hoàn toàn.
// Tối đa 2 cấp (tự tham chiếu qua parentId) — khớp đúng độ sâu menu web cũ (mục cấp 1 + dropdown con),
// KHÔNG cho phép cấp 3 (xem validate ở menu-items.service.ts).
// ============================================================================

model MenuItem {
  id    String @id @default(uuid())
  /// Mã cố định dùng để seed lại an toàn (upsert theo code, xem prisma/seed.ts) — KHÔNG hiển thị cho
  /// người dùng. Mục do admin tự tạo thêm sau này được service tự sinh 1 UUID ngẫu nhiên làm code (xem
  /// MenuItemsService.create) — KHÔNG để null, vì SQL Server chỉ cho phép tối đa 1 dòng NULL trên cột
  /// có UNIQUE constraint (khác Postgres/MySQL), để null sẽ khiến mục admin tạo thứ 2 trở đi bị lỗi
  /// "Unique constraint failed".
  code  String? @unique
  label String
  /// Đường dẫn khi bấm vào mục — vd "/gioi-thieu", "/tin-tuc?category=van-hoa-doc", "/gioi-thieu#lien-he".
  url       String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  /// Chỉ có ý nghĩa khi parentId=null (mục cấp 1) — bật thì khi dựng cây công khai (GET /menu),
  /// dropdown mục này được tự động chèn thêm các Category thật (isAboutSection=false, chưa gắn ở
  /// menu item nào khác) vào SAU danh sách mục con thủ công — dùng cho "Tin hoạt động" để menu tự
  /// cập nhật khi thêm chuyên mục mới, không cần sửa menu thủ công mỗi lần.
  autoCategoryChildren Boolean @default(false)

  parentId String?
  /// onDelete NoAction (SQL Server không hỗ trợ "Restrict" như MySQL/Postgres — Prisma chỉ chấp nhận
  /// Cascade/NoAction/SetNull/SetDefault cho provider sqlserver, xem lỗi P1012 nếu dùng nhầm Restrict).
  /// NoAction có tác dụng tương đương Restrict ở đây: DB sẽ chặn xoá 1 mục cấp 1 nếu còn mục con trỏ
  /// tới qua parentId — nhưng service luôn tự xoá children trước khi xoá cha (xem
  /// menu-items.service.ts#remove) nên trên thực tế constraint này không bao giờ bị chạm tới.
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children MenuItem[] @relation("MenuItemChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("menu_items")
}

// ============================================================================
// DOMAIN: SITESETTING — cấu hình chung toàn site (logo, thông tin liên hệ, SEO mặc định)
//
// Bảng chỉ có DUY NHẤT 1 dòng (id cố định "singleton", không cho tạo thêm — xem
// site-settings.service.ts#getOrCreate) — không dùng model rời cho từng field vì đây là cấu hình
// tổng thể chỉnh sửa qua 1 form admin duy nhất, không cần lịch sử nhiều bản ghi. apps/web (Header,
// Footer, thẻ <title>/<meta>) đọc qua GET /site-settings công khai; sửa qua PUT /admin/site-settings
// (chỉ ADMIN, xem prisma/seed.ts — "sitesetting" KHÔNG nằm trong clerkManagedModules).
// ============================================================================

model SiteSetting {
  /// Cố định "singleton" — đảm bảo chỉ có 1 dòng duy nhất, KHÔNG @default(uuid()) như các model khác.
  id String @id @default("singleton")

  siteName  String  @default("Công đoàn Trường Đại học Sư phạm Kỹ thuật Hưng Yên")
  shortName String  @default("Công đoàn UTEHY")
  slogan    String?
  /// Đoạn giới thiệu ngắn hiển thị ở footer — KHÔNG dùng cho thẻ meta description (xem seoDescription).
  description String? @db.NVarChar(Max)
  /// Đường dẫn ảnh logo — nhập tay giống HomeSlide.imageUrl (chưa có upload file qua admin ở bản MVP
  /// này), mặc định trỏ file tĩnh có sẵn tại apps/web/public/logo.png và apps/admin/public/logo.png.
  logoUrl String @default("/logo.png")

  address     String?
  hotline     String?
  officePhone String?
  email       String?
  facebookUrl String?
  youtubeUrl  String?

  workingHoursWeekday String?
  workingHoursLunch   String?
  workingHoursWeekend String?

  /// Dòng bản quyền cuối footer — KHÔNG gồm năm (footer tự chèn năm hiện tại phía trước, xem
  /// Footer.tsx) để không phải sửa cấu hình này mỗi khi sang năm mới.
  copyrightText String?

  /// Mặc định cho thẻ <title>/<meta name="description">/<meta name="keywords"> toàn site — áp dụng
  /// site-wide (chưa hỗ trợ SEO riêng theo từng trang ở bản MVP này).
  seoTitle       String?
  seoDescription String? @db.NVarChar(Max)
  seoKeywords    String?
  /// Ảnh chia sẻ mạng xã hội (og:image) — cùng quy ước nhập tay như logoUrl.
  ogImageUrl String?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// "Đăng ký hoạt động" (Tiện ích số, Phase 4b) — 1 sự kiện/hoạt động do Công đoàn tổ chức mà đoàn viên
/// có thể đăng ký tham gia trực tiếp trên web công khai, không cần đăng nhập (xem EventRegistration).
model Event {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.NVarChar(Max)
  location    String?
  startAt     DateTime?
  endAt       DateTime?
  /// Null = không giới hạn thời gian đăng ký (mở tới khi hết chỗ hoặc admin tự đóng bằng isPublic).
  registrationDeadline DateTime?
  /// Null = không giới hạn số lượng người đăng ký.
  capacity  Int?
  /// false = ẩn khỏi trang công khai (nháp/đã kết thúc) nhưng vẫn giữ lại lịch sử đăng ký cũ.
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations EventRegistration[]

  @@map("events")
}

/// 1 lượt đăng ký tham gia — email bắt buộc (KHÔNG optional) để dùng được unique constraint chặn đăng
/// ký trùng theo [eventId, email]; nếu để optional sẽ đụng đúng pitfall SQL Server chỉ cho phép 1 NULL
/// trên cột UNIQUE đã gặp ở MenuItem.code (xem ghi chú field đó) — tránh lặp lại bằng cách bắt buộc
/// nhập email ngay từ đầu thay vì phải tự sinh giá trị giả như đã làm cho MenuItem.code.
model EventRegistration {
  id           String   @id @default(uuid())
  fullName     String
  email        String
  phone        String?
  note         String?  @db.NVarChar(Max)
  registeredAt DateTime @default(now())

  eventId String
  /// onDelete Cascade có chủ đích — xoá 1 hoạt động thì xoá luôn danh sách đăng ký của nó (khác cách
  /// làm dè dặt "NoAction" của các quan hệ dữ liệu nội bộ khác — đăng ký hoạt động không có giá trị
  /// tham chiếu gì sau khi hoạt động gốc đã bị xoá).
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, email])
  @@index([eventId])
  @@map("event_registrations")
}

/// "Kho công cụ AI" (Tiện ích số, Phase 4c) — thư mục/kho công cụ AI được TUYỂN CHỌN (link ra ngoài,
/// vd ChatGPT/NotebookLM/Claude/Gemini/công cụ soạn bài giảng...) phục vụ giảng dạy/nghiên cứu, KHÔNG
/// phải tự xây AI/chatbot riêng — đã xác nhận phạm vi với người quản trị trước khi code (xem thiết kế
/// Phase 4). Trang công khai `/tien-ich-so-cong-doan/cong-cu-ai` yêu cầu đăng nhập (ProtectedRoute có
/// sẵn) nhưng KHÔNG cần permission riêng để XEM — bất kỳ role nào đã đăng nhập (kể cả MEMBER) đều xem
/// được, chỉ CRUD ở trang quản trị mới cần permission "aitoolresource:*" (xem PublicAiToolsController
/// dùng JwtAuthGuard đơn thuần, không có PermissionsGuard — giống pattern /auth/me).
model AiToolResource {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.NVarChar(Max)
  url         String
  /// Nhãn phân loại tự do (vd "Soạn bài giảng", "Nghiên cứu", "Chấm điểm") — không tách bảng riêng vì
  /// số lượng nhóm nhỏ, không cần CRUD riêng như Category/DocumentType.
  category  String?
  logoUrl   String?
  sortOrder Int      @default(0)
  /// false = ẩn khỏi trang công khai (nháp/đã ngừng dùng) nhưng vẫn giữ lại trong trang quản trị.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_tool_resources")
}

/// "Khảo sát ý kiến" (Tiện ích số, Phase 4d) — MVP CHỈ hỗ trợ 2 loại câu hỏi (SINGLE_CHOICE/TEXT, xem
/// SurveyQuestion.type), không có RATING/MULTIPLE_CHOICE (dời bản sau nếu cần). Theo đúng chính sách
/// đã áp dụng cho Event/EventRegistration (Phase 4b) — form trả lời công khai, KHÔNG bắt buộc đăng
/// nhập (isAnonymous mặc định true, không lưu userId trên SurveyResponse) để giữ nhất quán trải
/// nghiệm giữa 2 tính năng "điền form công khai" trong Tiện ích số.
model Survey {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.NVarChar(Max)
  /// false = đã đóng, ẩn khỏi trang công khai nhưng vẫn xem được kết quả ở trang quản trị.
  isOpen      Boolean   @default(true)
  /// MVP luôn true (không lưu danh tính người trả lời) — field giữ sẵn cho bản sau nếu cần khảo sát
  /// định danh (vd theo dõi ai đã trả lời để tránh gửi nhắc lại).
  isAnonymous Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@map("surveys")
}

model SurveyQuestion {
  id       String @id @default(uuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text     String
  /// "SINGLE_CHOICE" | "TEXT" (xem SurveyQuestionType trong @congdoan/types) — dùng String thay vì
  /// Prisma enum theo đúng convention field `direction` ở OfficialDocument (xem ghi chú field đó).
  type       String  @default("TEXT") @db.VarChar(20)
  /// JSON string mảng lựa chọn (vd ["Rất hài lòng","Hài lòng","Không hài lòng"]) — CHỈ có giá trị khi
  /// type="SINGLE_CHOICE", null khi type="TEXT".
  optionsJson String? @db.NVarChar(Max)
  sortOrder   Int     @default(0)
  isRequired  Boolean @default(true)

  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id          String   @id @default(uuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submittedAt DateTime @default(now())

  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String         @id @default(uuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questionId String
  /// onDelete: NoAction (KHÔNG Cascade) — vì Survey -> SurveyResponse -> SurveyAnswer đã là 1 đường
  /// cascade từ Survey xuống bảng này; nếu quan hệ này cũng Cascade thì có 2 đường cascade cùng hội tụ
  /// về SurveyAnswer (qua SurveyResponse VÀ qua SurveyQuestion), SQL Server không cho phép (lỗi Prisma
  /// P1012 "referential actions ... cascade ... through multiple paths"). Do đó SurveysService.
  /// removeQuestion() phải tự xoá SurveyAnswer liên quan bằng tay (deleteMany) TRƯỚC khi xoá
  /// SurveyQuestion, thay vì trông chờ CSDL tự dọn — xem service đó.
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Câu trả lời tự luận (type=TEXT), hoặc đúng 1 giá trị lựa chọn đã chọn (type=SINGLE_CHOICE).
  value      String         @db.NVarChar(Max)

  @@index([responseId])
  @@index([questionId])
  @@map("survey_answers")
}

// ============================================================================
// DOMAIN: PUBLICSERVICE — "Dịch vụ công" (Tiện ích số, Phase 4e) — đồng hành cùng viên chức, người lao
// động trong sử dụng dịch vụ công trực tuyến. Tính năng MỚI hoàn toàn, không migrate gì từ web cũ.
// Thiết kế theo 4 quyết định đã thống nhất với người quản trị (không hỏi lại):
//   1. Nội dung 8 trường hướng dẫn (PublicServiceProcedure) do Claude soạn sẵn dựa trên quy định hiện
//      hành cho ~8-9 thủ tục phổ biến, LUÔN seed isActive=false (nháp) — cán bộ Công đoàn phải tự rà
//      soát rồi mới bật hiển thị công khai qua trang quản trị (nội dung pháp lý cần xác minh lại).
//   2. "Cảnh báo và nhắc việc" (PublicServiceNotice) là bảng tin CHUNG do cán bộ đăng, KHÔNG cá nhân
//      hoá theo từng người dùng (không yêu cầu đăng nhập, không lưu hạn dùng riêng của từng người).
//   3. "Công đoàn hỗ trợ tôi" (PublicServiceSupportRequest) — gửi yêu cầu KHÔNG bắt buộc đăng nhập,
//      cùng chính sách với EventRegistration (4b)/SurveyResponse (4d).
//   4. Toàn bộ 4 model dưới đây triển khai 1 lượt duy nhất (không chia đợt nhỏ như 4a-4d).
// LƯU Ý cascade path (bài học P1012 từ domain Survey ở trên): PublicServiceSupportRequest có 2 quan hệ
// tuỳ chọn (procedure, assignedTo) — CẢ HAI đều dùng onDelete: SetNull (không Cascade), nên không có
// nguy cơ hội tụ nhiều đường cascade như Survey->SurveyResponse/SurveyQuestion->SurveyAnswer.
// ============================================================================

/// Nhóm 1 (Tra cứu nhanh dịch vụ công) + Nhóm 2 (Hướng dẫn từng bước, mẫu 8 phần cố định) — gộp 1 model
/// vì nhóm 2 chỉ là phần chi tiết mở rộng của đúng 1 bản ghi nhóm 1 (1-1), không phải quan hệ cha-con.
model PublicServiceProcedure {
  id    String @id @default(uuid())
  /// Dùng cho URL trang chi tiết công khai (/tien-ich-so-cong-doan/dich-vu-cong/thu-tuc/:slug).
  slug  String @unique
  title String

  /// Nhãn phân loại CỐ ĐỊNH cho lưới "Tra cứu nhanh" nhóm 1 — xem PUBLIC_SERVICE_PROCEDURE_CATEGORIES
  /// trong @congdoan/types (CAN_CUOC/CU_TRU/HO_TICH/BHXH_BHYT/THUE_TNCN/LY_LICH_TU_PHAP/GPLX/
  /// DANG_KY_PHUONG_TIEN/KHAC — đúng danh sách người quản trị đã liệt kê). Dùng String thay vì Prisma
  /// enum, cùng convention OfficialDocument.direction/SurveyQuestion.type (SQL Server connector của
  /// Prisma không hỗ trợ enum gốc).
  category String @db.VarChar(30)

  /// Mô tả ngắn hiển thị ở thẻ/lưới danh sách (khác nội dung chi tiết 8 phần bên dưới).
  summary String? @db.NVarChar(Max)

  // Mẫu 8 phần cố định của nhóm 2 (Hướng dẫn từng bước) — TẤT CẢ optional vì có thể chưa soạn đủ hết,
  // trang chi tiết công khai chỉ hiện phần nào có nội dung.
  /// 1. Điều kiện
  conditions String? @db.NVarChar(Max)
  /// 2. Hồ sơ cần chuẩn bị
  requiredDocuments String? @db.NVarChar(Max)
  /// 3. Nơi thực hiện
  whereToApply String? @db.NVarChar(Max)
  /// 4. Các bước thao tác
  steps String? @db.NVarChar(Max)
  /// 5. Phí/lệ phí
  fee String? @db.NVarChar(Max)
  /// 6. Thời hạn
  processingTime String? @db.NVarChar(Max)
  /// 7. Cách nhận kết quả
  resultDelivery String? @db.NVarChar(Max)
  /// 8. Lỗi thường gặp
  commonMistakes String? @db.NVarChar(Max)

  sortOrder Int @default(0)
  /// false = nháp — mặc định false khi seed nội dung do Claude soạn sẵn (xem ghi chú domain block phía
  /// trên); admin CHỈ bật true sau khi đã rà soát nội dung là chính xác/còn hiệu lực.
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supportRequests PublicServiceSupportRequest[]

  @@index([category])
  @@index([isActive, sortOrder])
  @@map("public_service_procedures")
}

/// Nhóm 3 (Kho biểu mẫu và đường dẫn chính thống) — thư mục link ra các cổng dịch vụ công chính thống
/// (Cổng DVC Quốc gia, VNeID, BHXH Việt Nam, Cơ quan thuế, cổng chuyên ngành...). QR code để quét
/// nhanh được TẠO Ở PHÍA CLIENT (apps/web) trực tiếp từ field `url` bằng ảnh QR sinh động (API ảnh QR
/// công khai) — KHÔNG lưu ảnh QR trong CSDL, tránh phải tự dựng/host thư viện tạo mã QR mới.
model PublicServiceLink {
  id          String  @id @default(uuid())
  title       String
  url         String
  description String? @db.NVarChar(Max)
  /// Nhãn nhóm tự do (vd "Cổng Dịch vụ công Quốc gia", "Định danh điện tử - VNeID", "BHXH Việt Nam",
  /// "Cơ quan thuế", "Cổng chuyên ngành khác") — cùng convention AiToolResource.category, không tách
  /// bảng riêng vì số lượng nhóm nhỏ.
  group     String?
  logoUrl   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("public_service_links")
}

/// Nhóm 4 ("Công đoàn hỗ trợ tôi") — PHẦN NỔI BẬT NHẤT theo yêu cầu người quản trị. Người lao động chọn
/// "Tôi cần làm thủ tục gì?" (procedureId nếu có trong danh mục, hoặc procedureOther nếu không) → "Tôi
/// đang vướng ở bước nào?" (stuckStep) → gửi yêu cầu, KHÔNG bắt buộc đăng nhập (cùng chính sách
/// EventRegistration/SurveyResponse). Cán bộ Công đoàn triage qua trang quản trị: đổi status, phân công
/// cán bộ (assignedTo), ghi chú nội bộ (staffNote).
model PublicServiceSupportRequest {
  id    String  @id @default(uuid())
  fullName String
  /// Ít nhất 1 trong 2 (phone/email) phải có — validate ở tầng DTO/service (KHÔNG dùng CHECK constraint
  /// CSDL, giữ đơn giản như các form công khai khác trong dự án).
  phone String?
  email String?

  procedureId String?
  /// onDelete: SetNull (KHÔNG Cascade) — xoá 1 thủ tục trong kho tra cứu không được xoá luôn lịch sử
  /// yêu cầu hỗ trợ đã gửi, chỉ mất liên kết tới thủ tục gốc (procedureOther vẫn còn nguyên làm tham
      /// khảo). onUpdate NoAction theo đúng convention các quan hệ optional khác trong dự án.
  procedure PublicServiceProcedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// Tên thủ tục tự nhập khi người dùng không chọn được thủ tục có sẵn trong danh mục (vd thủ tục mới/
  /// hiếm gặp chưa có trong Tra cứu nhanh).
  procedureOther String?

  /// "Tôi đang vướng ở bước nào?" — mô tả người dùng tự nhập.
  stuckStep   String? @db.NVarChar(Max)
  description String? @db.NVarChar(Max)

  /// "NEW" | "IN_PROGRESS" | "RESOLVED" | "CLOSED" (xem PublicServiceSupportRequestStatus trong
  /// @congdoan/types) — String thay vì Prisma enum, cùng convention OfficialDocument.status.
  status String @default("NEW") @db.VarChar(20)

  assignedToUserId String?
  /// onDelete: SetNull — xoá tài khoản cán bộ không được xoá lịch sử yêu cầu, chỉ bỏ phân công.
  assignedTo User? @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// Ghi chú nội bộ của cán bộ xử lý — KHÔNG hiển thị ra trang công khai.
  staffNote String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([procedureId])
  @@index([assignedToUserId])
  @@map("public_service_support_requests")
}

/// Nhóm 5 (Cảnh báo và nhắc việc) — bảng tin CHUNG do cán bộ Công đoàn đăng (hết hạn GPLX theo mùa,
/// đổi chính sách BHXH/BHYT, hạn quyết toán thuế TNCN, hạn thực hiện thủ tục liên quan viên chức, dịch
/// vụ công mới...), hiển thị công khai cho MỌI người xem, KHÔNG cá nhân hoá/không yêu cầu đăng nhập
/// (xem ghi chú domain block phía trên — quyết định đã chốt, không xây bản theo dõi hạn riêng từng
/// người ở vòng này).
model PublicServiceNotice {
  id      String @id @default(uuid())
  title   String
  content String @db.NVarChar(Max)
  /// Nhãn phân loại cố định — xem PUBLIC_SERVICE_NOTICE_CATEGORIES trong @congdoan/types.
  category String? @db.VarChar(30)
  /// true = ghim lên đầu danh sách (thông báo quan trọng/khẩn).
  isPinned Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isPinned, createdAt])
  @@map("public_service_notices")
}

// ============================================================================
// TODO Phase 2 — DOMAIN: MEMBERSHIP (phần còn lại)
//   Danh bạ công khai (UnionMember/UnionDepartment) đã triển khai ở trên — phần CÒN LẠI của Phase 2
//   (tài khoản đoàn viên tự quản lý, đóng đoàn phí, Leader/Position/Term đầy đủ...) làm sau nếu cần.
//   (xem mục 4 CURSOR_PROMPT_Website_CongDoan_UTEHY.md để lấy đúng tên field)
//
// TODO Phase 4 — DOMAIN: DIGITALUTILITY ("Tiện ích số Công đoàn") — phần còn lại
//   Event/EventRegistration (4b), AiToolResource (4c), Survey/SurveyQuestion/SurveyResponse/
//   SurveyAnswer (4d), PublicServiceProcedure/PublicServiceLink/PublicServiceSupportRequest/
//   PublicServiceNotice (4e — Dịch vụ công) đã triển khai ở trên. Còn lại (chưa nằm trong các mục ưu
//   tiên ban đầu):
//   model EForm, EFormSubmission, UnionFeeLedger,
//         ChatbotConversation, ChatbotMessage
// ============================================================================
